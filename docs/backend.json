{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores additional information about a user.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "accountType": {
          "type": "string",
          "enum": [
            "Free",
            "Pro",
            "Agent"
          ],
          "description": "The user's account subscription type."
        },
        "currentRole": {
          "type": "string",
          "description": "The user's current or target job role."
        },
        "experienceLevel": {
          "type": "string",
          "enum": [
            "Student",
            "Junior",
            "Mid",
            "Senior"
          ],
          "description": "The user's professional experience level."
        },
        "location": {
          "type": "string",
          "description": "The user's geographical location."
        },
        "cvs": {
          "type": "array",
          "description": "A list of the user's uploaded CVs.",
          "items": {
            "type": "object",
            "properties": {
              "fileName": {
                "type": "string"
              },
              "storagePath": {
                "type": "string"
              },
              "uploadedAt": {
                "type": "string",
                "format": "date-time"
              },
              "lastScanned": {
                "type": "string",
                "format": "date-time"
              },
              "bestMatchScore": {
                "type": "number"
              }
            },
            "required": [
              "fileName",
              "storagePath",
              "uploadedAt"
            ]
          }
        },
        "jobPreferences": {
          "type": "object",
          "description": "User's job search preferences.",
          "properties": {
            "preferredRoles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workModel": {
              "type": "string",
              "enum": [
                "Remote",
                "Hybrid",
                "On-site"
              ]
            },
            "salaryRange": {
              "type": "string"
            }
          }
        },
        "scanHistory": {
          "type": "array",
          "description": "A history of the user's past CV scans.",
          "items": {
            "type": "object",
            "properties": {
              "jobTitle": {
                "type": "string"
              },
              "matchScore": {
                "type": "number"
              },
              "scanDate": {
                "type": "string",
                "format": "date-time"
              },
              "reportId": {
                "type": "string"
              }
            },
            "required": [
              "jobTitle",
              "matchScore",
              "scanDate",
              "reportId"
            ]
          }
        }
      },
      "required": [
        "displayName",
        "email",
        "accountType"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile data, keyed by user ID."
    }
  }
}
