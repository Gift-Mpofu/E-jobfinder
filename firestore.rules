
/**
 * Core Philosophy: Strict user-ownership model with a global bypass for the Master Admin.
 *
 * Data Structure: All data is nested under `/users/{userId}`.
 *
 * Key Security Decisions:
 * - Admin Access: The master account 'giftmpofud@gmail.com' is granted global 
 *   read/write access to all collections and document groups.
 * - User Isolation: Standard users are confined to their own document tree.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user is the designated Master Admin.
     * Note: We use lowercase to ensure consistent comparison.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'giftmpofud@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ----------------------------------------------------------------------
    // Global Admin Bypass
    // ----------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // Standard User Collection Rules
    // ----------------------------------------------------------------------

    match /users/{userId} {
      // Owner can access their own profile.
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == userId;
      allow delete: if isOwner(userId);

      match /cvs/{cvId} {
        allow read, write: if isOwner(userId);

        match /matchResults/{matchResultId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /jobDescriptions/{jobDescriptionId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
