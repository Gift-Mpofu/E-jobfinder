
/**
 * Core Philosophy: This ruleset implements a strict user-ownership security model
 * with an Administrative bypass for the designated master user.
 *
 * Data Structure: All data is nested under `/users/{userId}`.
 *
 * Key Security Decisions:
 * - Admin Access: The user with email 'giftmpofud@gmail.com' is granted global
 *   read/write access to manage user quotas and support.
 * - User Isolation: Standard users are confined to their own document tree.
 * - No User Listing: Only the Admin can list the top-level `/users` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user is the designated Admin.
     * Note: comparison is case-sensitive in rules.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'giftmpofud@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingDocument() {
      return resource != null;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDocument();
    }
    
    function isValidUserCreate(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }
    
    function isImmutableUserId() {
      return request.resource.data.id == resource.data.id;
    }
    
    function isValidOwnedDocumentCreate(userId) {
      return isOwner(userId) && request.resource.data.userId == userId;
    }
    
    function isImmutableOwnerLink() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ----------------------------------------------------------------------
    // Collection Group Rules (Admin Only)
    // ----------------------------------------------------------------------
    
    match /{path=**}/cvs/{cvId} {
      allow read, write: if isAdmin();
    }
    
    match /{path=**}/jobDescriptions/{jobDescriptionId} {
      allow read, write: if isAdmin();
    }
    
    match /{path=**}/matchResults/{matchResultId} {
      allow read, write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // Standard Collection Rules
    // ----------------------------------------------------------------------

    match /users/{userId} {
      // Admin can list and get any user. Owner can only get their own.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isValidUserCreate(userId);
      
      // Admin can update any user (for quota management). Owner can update their own.
      allow update: if (isExistingOwner(userId) && isImmutableUserId()) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();

      match /cvs/{cvId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isValidOwnedDocumentCreate(userId);
        allow update: if (isExistingOwner(userId) && isImmutableOwnerLink()) || isAdmin();
        allow delete: if isExistingOwner(userId) || isAdmin();

        match /matchResults/{matchResultId} {
          allow get, list, create: if isOwner(userId) || isAdmin();
          allow update, delete: if isExistingOwner(userId) || isAdmin();
        }
      }

      match /jobDescriptions/{jobDescriptionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isValidOwnedDocumentCreate(userId);
        allow update: if (isExistingOwner(userId) && isImmutableOwnerLink()) || isAdmin();
        allow delete: if isExistingOwner(userId) || isAdmin();
      }
    }
  }
}
