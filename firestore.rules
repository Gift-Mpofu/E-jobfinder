rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Direct UID check for the master admin to ensure access even if document check fails during setup
      return request.auth != null && (
        request.auth.uid == "xDMDtL06TxPpwswz5WuztWQ7EGO2" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // Global admin bypass
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow nested collections under users to be accessed by the owner
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}